# Firebase コンソール > プロジェクトの設定 > マイアプリ（ウェブ）の値を入れる
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true にするとローカルの Firebase Emulator（Auth:9099 / Firestore:8080）につなぐ
VITE_USE_EMULATOR=false

# true にすると、試作版の見本の種 8 つを置く（公開版では置かない）
VITE_USE_SAMPLES=false

# --- Emulator だけで動かす場合の例（npm run emulators と併用）---
# VITE_FIREBASE_API_KEY=demo-key
# VITE_FIREBASE_PROJECT_ID=demo-sabaku
# VITE_FIREBASE_AUTH_DOMAIN=demo-sabaku.firebaseapp.com
# VITE_USE_EMULATOR=true
