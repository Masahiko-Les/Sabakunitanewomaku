rules_version = '2';
// users / seeds（読む・蒔く・配達）/ worlds/{uid}/tiles（自分の種・届いた種の配置）
// / seeds/{id}/letters/{書いた人の uid}（手紙とありがとう）。
// テスト：npm run test:rules（Emulator で scripts/rules-*.mjs をすべて実行する）
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isTile(v) { return v is int && v >= 0 && v < 100; }

    // ---------- users ----------
    // 'YYYY-MM-DD'（端末の日付）。未来の日付で上限をすり抜けないよう、サーバーの時刻＋1 日までに限る
    function okDate(d) {
      return d is string && (d == ''
        || (d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) <= request.time + duration.value(1, 'd')));
    }
    // 見本の種への手紙（s0〜s7）。どこにも送られない
    function okSample(m, k) {
      return !(k in m) || (m[k] is map && m[k].keys().hasOnly(['text','t','thanked'])
        && m[k].text is string && m[k].text.size() > 0 && m[k].text.size() <= 300
        && m[k].t is number && m[k].thanked is bool);
    }
    function okSamples(m) {
      return m is map && m.keys().hasOnly(['s0','s1','s2','s3','s4','s5','s6','s7'])
        && okSample(m,'s0') && okSample(m,'s1') && okSample(m,'s2') && okSample(m,'s3')
        && okSample(m,'s4') && okSample(m,'s5') && okSample(m,'s6') && okSample(m,'s7');
    }
    function okUser(d) {
      return d.keys().hasOnly(['createdAt','tutorial','metGranny','introSeen','grannyLetter',
                               'receivedToday','receivedDate','seen','sampleLetters','muted',
                               'openingSeen','interest','dummies'])
        && d.get('tutorial', 0) is int && d.get('tutorial', 0) >= 0 && d.get('tutorial', 0) <= 3
        && d.get('metGranny', false) is bool
        && d.get('introSeen', false) is bool
        && (d.get('grannyLetter', null) == null
            || (d.grannyLetter is string && d.grannyLetter.size() <= 300))
        && d.get('receivedToday', 0) is int && d.get('receivedToday', 0) >= 0 && d.get('receivedToday', 0) <= 3
        && okDate(d.get('receivedDate', ''))
        && (d.get('seen', {}) is map && d.get('seen', {}).size() <= 2000)
        // オープニング：見たかどうかと、女の子の問いで選んだ関心テーマ（スキップしたときは null）
        && d.get('openingSeen', false) is bool
        && (d.get('interest', null) == null
            || d.interest in ['吃音','うつ','不安・パニック','摂食障害','発達の特性','介護','子育て','不登校・ひきこもり','仕事','人間関係','その他','none'])
        // 知らせた手紙（自分の画面に出さない）
        && (d.get('muted', {}) is map && d.get('muted', {}).size() <= 2000)
        && okSamples(d.get('sampleLetters', {}))
        && okDummies(d.get('dummies', {}));
    }
    // おばあちゃんの種が咲いたあとに蒔かれる 3 つの種の場所（見本の文章 s0〜s7 から選ぶ）
    function okDummy(m, k) {
      return !(k in m) || (m[k] is map && m[k].keys().hasOnly(['x','y'])
        && m[k].x is int && m[k].x >= 0 && m[k].x < 100 && m[k].y is int && m[k].y >= 0 && m[k].y < 100);
    }
    function okDummies(m) {
      return m is map && m.size() <= 3 && m.keys().hasOnly(['s0','s1','s2','s3','s4','s5','s6','s7'])
        && okDummy(m,'s0') && okDummy(m,'s1') && okDummy(m,'s2') && okDummy(m,'s3')
        && okDummy(m,'s4') && okDummy(m,'s5') && okDummy(m,'s6') && okDummy(m,'s7');
    }
    // 1 日の受け取り数は、同じ日のうちは減らせない。日付は進めることしかできず、進めたら 1 から数え直す
    function okCount(o, n) {
      return (n.get('receivedDate', '') == o.get('receivedDate', '')
              && n.get('receivedToday', 0) >= o.get('receivedToday', 0))
        || (n.get('receivedDate', '') > o.get('receivedDate', '') && n.get('receivedToday', 0) <= 1);
    }
    // 配達 1 回で、ちょうど 1 つ数える（1 日 3 つまで）
    function countedOne(o, n) {
      return n.get('receivedToday', 0) <= 3
        && ((n.get('receivedDate', '') == o.get('receivedDate', '')
             && n.get('receivedToday', 0) == o.get('receivedToday', 0) + 1)
            || (n.get('receivedDate', '') > o.get('receivedDate', '') && n.get('receivedToday', 0) == 1));
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && okUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('receivedToday', 0) == 0
        && request.resource.data.get('receivedDate', '') == '';
      allow update: if signedIn() && me() == uid
        && okUser(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        && okCount(resource.data, request.resource.data);
      // 「すべてのデータを消す」：自分の記録だけは消せる
      allow delete: if signedIn() && me() == uid;
    }

    match /worlds/{uid}/tiles/{seedId} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['seedId','x','y','kind','placedAt'])
        && request.resource.data.seedId == seedId
        && isTile(request.resource.data.x) && isTile(request.resource.data.y)
        && request.resource.data.placedAt == request.time
        && (
          (request.resource.data.kind == 'own'
            && getAfter(/databases/$(db)/documents/seeds/$(seedId)).data.ownerUid == uid)
          ||
          // 届いた種：配達（seeds の update）と同じトランザクションでだけ置ける
          (request.resource.data.kind == 'received'
            && !(uid in get(/databases/$(db)/documents/seeds/$(seedId)).data.deliveredTo)
            && uid in getAfter(/databases/$(db)/documents/seeds/$(seedId)).data.deliveredTo)
        );
      allow update: if false;
      // 「すべてのデータを消す」：自分の世界のタイルだけは消せる（消しても、同じ種はもう受け取れない）
      allow delete: if signedIn() && me() == uid;
    }

    match /seeds/{seedId} {
      // 読めるのは、蒔いた人と、まだ届け先を探している公開中の種（配達のため）と、自分に届いた公開中の種だけ
      allow read: if signedIn()
        && (resource.data.ownerUid == me()
            || (resource.data.status == 'public'
                && (resource.data.open == true || me() in resource.data.deliveredTo)));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','h','f','flower','createdAt','status','open','deliveredCount','deliveredTo'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.h is string && request.resource.data.h.size() > 0 && request.resource.data.h.size() <= 60
        // ②（向き合い方）は書かなくてもよい（null）
        && (request.resource.data.get('f', null) == null
            || (request.resource.data.f is string && request.resource.data.f.size() > 0 && request.resource.data.f.size() <= 240))
        && request.resource.data.flower is int && request.resource.data.flower >= 0 && request.resource.data.flower <= 4
        && request.resource.data.createdAt == request.time
        && request.resource.data.status in ['public', 'hidden']
        && request.resource.data.deliveredCount == 0
        && request.resource.data.deliveredTo.size() == 0
        && request.resource.data.open == (request.resource.data.status == 'public')
        // 種は、自分の世界のタイルと同時にしか蒔けない
        && existsAfter(/databases/$(db)/documents/worlds/$(me())/tiles/$(seedId));

      // 配達：ほかの人が、自分の分の枠を 1 つ受け取る（自分の世界のタイルと同時に）
      allow update: if signedIn()
        && resource.data.ownerUid != me()
        && resource.data.status == 'public'
        && resource.data.open == true
        && resource.data.deliveredCount < 5
        && !(me() in resource.data.deliveredTo)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredCount','deliveredTo','open'])
        && request.resource.data.deliveredCount == resource.data.deliveredCount + 1
        && request.resource.data.deliveredTo == resource.data.deliveredTo.concat([me()])
        && request.resource.data.open == (request.resource.data.deliveredCount < 5)
        // 配達を受け付けるのは、蒔いてから 24 時間まで（届け先が 5 人に満たなくても、そこで終わり）
        && request.time < resource.data.createdAt + duration.value(24, 'h')
        && existsAfter(/databases/$(db)/documents/worlds/$(me())/tiles/$(seedId))
        // 同じトランザクションで、自分の 1 日の受け取り数を 1 つ数える
        && countedOne(get(/databases/$(db)/documents/users/$(me())).data,
                      getAfter(/databases/$(db)/documents/users/$(me())).data);

      allow delete: if false;

      // 手紙：ドキュメント ID＝書いた人の uid（1 つの種に 1 人 1 回）
      match /letters/{writer} {
        function seed() { return get(/databases/$(db)/documents/seeds/$(seedId)).data; }

        // 読めるのは、蒔いた人と、その手紙を書いた人だけ
        allow read: if signedIn() && (me() == writer || seed().ownerUid == me());

        // 書けるのは、自分の世界に届いた公開中の種だけ（自分の種には書けない）
        allow create: if signedIn() && me() == writer
          && seed().ownerUid != me()
          && seed().status == 'public'
          && exists(/databases/$(db)/documents/worlds/$(me())/tiles/$(seedId))
          && request.resource.data.keys().hasOnly(['writerUid','text','createdAt','thanked','thankedAt'])
          && request.resource.data.writerUid == me()
          // 種と芽は、蒔いてから 1 週間で消える。手紙を書けるのはそれまで
          && request.time < seed().createdAt + duration.value(7, 'd')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time
          && request.resource.data.thanked == false
          && request.resource.data.thankedAt == null;

        // ありがとう：蒔いた人だけが、false → true にできる（取り消せない）
        allow update: if signedIn() && seed().ownerUid == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thanked','thankedAt'])
          && resource.data.thanked == false
          && request.resource.data.thanked == true
          && request.resource.data.thankedAt == request.time
          // ありがとうを返せるのも、蒔いてから 1 週間まで
          && request.time < seed().createdAt + duration.value(7, 'd');

        allow delete: if false;
      }
    }

    // ---------- reports（知らせる）----------
    // 書けるのは自分の世界にあるものだけ。ID が決まっているので、同じものを 2 度は知らせられない。
    // 読むのは運営（Firebase コンソール）だけ
    match /reports/{rid} {
      function rd() { return request.resource.data; }
      allow create: if signedIn()
        && rd().keys().hasOnly(['reporterUid','kind','seedId','writerUid','createdAt'])
        && rd().reporterUid == me()
        && rd().createdAt == request.time
        && rd().seedId is string
        && (
          // 届いた種を知らせる（同じバッチで、自分の世界のタイルを消す）
          (rd().kind == 'seed' && rd().writerUid == null
            && rid == me() + '_' + rd().seedId
            && exists(/databases/$(db)/documents/worlds/$(me())/tiles/$(rd().seedId))
            && get(/databases/$(db)/documents/seeds/$(rd().seedId)).data.ownerUid != me())
          ||
          // 自分の種に届いた、ほかの人の手紙を知らせる
          (rd().kind == 'letter' && rd().writerUid is string && rd().writerUid != me()
            && rid == me() + '_' + rd().seedId + '_' + rd().writerUid
            && get(/databases/$(db)/documents/seeds/$(rd().seedId)).data.ownerUid == me()
            && exists(/databases/$(db)/documents/seeds/$(rd().seedId)/letters/$(rd().writerUid)))
        );
      allow read, update, delete: if false;
    }
  }
}
